TYPESAFE_API_KEY=
OPENAI_API_KEY=
JEV_MODEL=jev-latest
MC_HOST=localhost
MC_PORT=25565
MC_USERNAME=JevRunner
MC_AUTH=offline
# Optional: otherwise negotiate the server version.
MC_VERSION=
DECISION_MS=1500
MAX_DECISIONS=2000
MAX_MINUTES=120
MIN_CONFIDENCE=0.2
ACTION_TIMEOUT_MS=20000
# Keep the same ID when reopening the same world on a different LAN port.
# Change it for a new world to avoid reusing old coordinates.
WORLD_ID=lan-world
VIEWER=1
VIEWER_PORT=3007
